# /opt/teriyaki/app.env (владелец deploy, chmod 600). Значения в одинарных кавычках — compose
# подставляет $VAR в env-файлах, кавычки это отключают.

# Пароль роли teriyaki: openssl rand -hex 24 (hex — не нужно url-кодировать).
DATABASE_URL='postgres://teriyaki:changeme@localhost:5432/teriyaki?sslmode=disable'

# Токен бота из @BotFather — им проверяется подпись initData.
BOT_TOKEN=''

# DEV_USER_ID на проде НЕ задавать: он отключает проверку авторизации.
