# /opt/teriyaki/caddy.env (владелец deploy, chmod 600). Значения в одинарных кавычках — compose
# подставляет $VAR в env-файлах, а bcrypt-хэш весь из $.

# Домен, A-запись которого смотрит на VPS (DuckDNS или свой).
DOMAIN='teriyaki.duckdns.org'

# Логин и bcrypt-хэш пароля для /docs и /openapi.yaml. Хэш:
#   docker run --rm caddy:2.11 caddy hash-password --plaintext 'пароль'
DOCS_USER='frontend'
DOCS_PASSWORD_HASH=''
